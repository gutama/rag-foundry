{
  "$description": "Assay, the RAG Foundry design system. Source of truth for tokens.css and tailwind.css: edit this file, then run python design-system/build_tokens.py. Theme and status colors carry their dark-theme value in $extensions.org.ragfoundry.dark.",
  "color": {
    "$type": "color",
    "$description": "Palette. Components use the theme and status colors below, not these directly.",
    "graphite": {
      "$description": "Cool grey neutrals that carry the interface.",
      "0": {"$value": "#ffffff"},
      "50": {"$value": "#f2f3f5"},
      "100": {"$value": "#e9ebef"},
      "200": {"$value": "#d5d9e0"},
      "300": {"$value": "#aeb4bf"},
      "400": {"$value": "#858c99"},
      "500": {"$value": "#5a6170"},
      "600": {"$value": "#414957"},
      "700": {"$value": "#2b313c"},
      "800": {"$value": "#1e232c"},
      "850": {"$value": "#161a21"},
      "900": {"$value": "#0e1116"},
      "950": {"$value": "#0b0d11"}
    },
    "cobalt": {
      "$description": "Action: buttons, links, focus, selection.",
      "50": {"$value": "#eef2fe"},
      "100": {"$value": "#dde5fd"},
      "200": {"$value": "#bccbfa"},
      "300": {"$value": "#8ea6ff"},
      "400": {"$value": "#3d63e6"},
      "500": {"$value": "#2d4fd6"},
      "600": {"$value": "#2340b3"},
      "700": {"$value": "#1b3288"},
      "900": {"$value": "#101d4f"}
    },
    "ingot": {
      "$description": "Evidence only: citation markers, highlighted spans, bounding boxes. Never for warnings or decoration.",
      "50": {"$value": "#fff7e6"},
      "100": {"$value": "#fdebc2"},
      "200": {"$value": "#f9d78a"},
      "300": {"$value": "#f2bf4e"},
      "400": {"$value": "#e3a21a"},
      "500": {"$value": "#c7860b"},
      "700": {"$value": "#8a5a00"},
      "800": {"$value": "#6b4500"},
      "900": {"$value": "#4a3000"},
      "950": {"$value": "#1e1400"}
    }
  },
  "theme": {
    "$type": "color",
    "$description": "Semantic colors. $value is the light theme; $extensions.org.ragfoundry.dark is the dark theme.",
    "bg": {
      "$description": "Page canvas.",
      "$value": "#f2f3f5",
      "$extensions": {"org.ragfoundry": {"dark": "#0e1116"}}
    },
    "surface": {
      "$description": "Panels, cards and tables.",
      "$value": "#ffffff",
      "$extensions": {"org.ragfoundry": {"dark": "#161a21"}}
    },
    "surface-raised": {
      "$description": "Popovers, menus and dialogs. Pair with a shadow.",
      "$value": "#ffffff",
      "$extensions": {"org.ragfoundry": {"dark": "#1e232c"}}
    },
    "surface-sunken": {
      "$description": "Wells, segmented-control tracks, the document viewer backdrop.",
      "$value": "#e9ebef",
      "$extensions": {"org.ragfoundry": {"dark": "#0b0d11"}}
    },
    "border": {
      "$description": "Hairlines between regions.",
      "$value": "#d5d9e0",
      "$extensions": {"org.ragfoundry": {"dark": "#2b313c"}}
    },
    "border-strong": {
      "$description": "Emphasized dividers. Decorative; not enough contrast to outline a control.",
      "$value": "#aeb4bf",
      "$extensions": {"org.ragfoundry": {"dark": "#414957"}}
    },
    "border-control": {
      "$description": "Outlines of inputs, selects and outlined buttons (3:1 against surfaces).",
      "$value": "#858c99",
      "$extensions": {"org.ragfoundry": {"dark": "#858c99"}}
    },
    "fg": {
      "$description": "Primary text.",
      "$value": "#161a21",
      "$extensions": {"org.ragfoundry": {"dark": "#e9ebef"}}
    },
    "fg-secondary": {
      "$description": "Body copy that supports a heading.",
      "$value": "#414957",
      "$extensions": {"org.ragfoundry": {"dark": "#aeb4bf"}}
    },
    "fg-muted": {
      "$description": "Metadata, captions, placeholders.",
      "$value": "#5a6170",
      "$extensions": {"org.ragfoundry": {"dark": "#858c99"}}
    },
    "action": {
      "$description": "Fill of the one primary action in a region.",
      "$value": "#2d4fd6",
      "$extensions": {"org.ragfoundry": {"dark": "#3d63e6"}}
    },
    "action-hover": {
      "$description": "Primary action on hover and press.",
      "$value": "#2340b3",
      "$extensions": {"org.ragfoundry": {"dark": "#2d4fd6"}}
    },
    "on-action": {
      "$description": "Text and icons on the action fill.",
      "$value": "#ffffff",
      "$extensions": {"org.ragfoundry": {"dark": "#ffffff"}}
    },
    "action-subtle": {
      "$description": "Selected rows, active facet chips.",
      "$value": "#eef2fe",
      "$extensions": {"org.ragfoundry": {"dark": "#101d4f"}}
    },
    "on-action-subtle": {
      "$description": "Text on action-subtle.",
      "$value": "#1b3288",
      "$extensions": {"org.ragfoundry": {"dark": "#dde5fd"}}
    },
    "link": {
      "$description": "Inline links and text buttons.",
      "$value": "#2340b3",
      "$extensions": {"org.ragfoundry": {"dark": "#8ea6ff"}}
    },
    "focus": {
      "$description": "Focus ring: 2px, offset 2px.",
      "$value": "#2d4fd6",
      "$extensions": {"org.ragfoundry": {"dark": "#8ea6ff"}}
    },
    "evidence-highlight": {
      "$description": "Background of a cited span in an excerpt.",
      "$value": "#f9d78a",
      "$extensions": {"org.ragfoundry": {"dark": "#54431f"}}
    },
    "evidence-stroke": {
      "$description": "Bounding box drawn over a cited region of a page.",
      "$value": "#c7860b",
      "$extensions": {"org.ragfoundry": {"dark": "#e3a21a"}}
    },
    "evidence-marker": {
      "$description": "Fill of an inline citation marker.",
      "$value": "#f9d78a",
      "$extensions": {"org.ragfoundry": {"dark": "#e3a21a"}}
    },
    "on-evidence-marker": {
      "$description": "Number inside a citation marker.",
      "$value": "#4a3000",
      "$extensions": {"org.ragfoundry": {"dark": "#1e1400"}}
    },
    "evidence-marker-active": {
      "$description": "Citation marker whose source is open in the evidence panel.",
      "$value": "#4a3000",
      "$extensions": {"org.ragfoundry": {"dark": "#fdebc2"}}
    },
    "on-evidence-marker-active": {
      "$description": "Number inside an active citation marker.",
      "$value": "#f9d78a",
      "$extensions": {"org.ragfoundry": {"dark": "#4a3000"}}
    }
  },
  "status": {
    "$type": "color",
    "$description": "Lifecycle and feedback states. Always render with an icon and a text label, never color alone.",
    "candidate": {
      "$description": "Proposed or extracted, not yet checked. Dashed border.",
      "bg": {"$value": "transparent", "$extensions": {"org.ragfoundry": {"dark": "transparent"}}},
      "fg": {"$value": "#414957", "$extensions": {"org.ragfoundry": {"dark": "#aeb4bf"}}},
      "border": {"$value": "#858c99", "$extensions": {"org.ragfoundry": {"dark": "#858c99"}}}
    },
    "validated": {
      "$description": "Machine checks passed; waiting for review.",
      "bg": {"$value": "#e0f2f2", "$extensions": {"org.ragfoundry": {"dark": "#0f2e30"}}},
      "fg": {"$value": "#0b5f63", "$extensions": {"org.ragfoundry": {"dark": "#7fd4d4"}}},
      "border": {"$value": "#8ccfcf", "$extensions": {"org.ragfoundry": {"dark": "#1e5a5c"}}}
    },
    "approved": {
      "$description": "Approved by a reviewer. The only filled status.",
      "bg": {"$value": "#1d6b37", "$extensions": {"org.ragfoundry": {"dark": "#1d6b37"}}},
      "fg": {"$value": "#ffffff", "$extensions": {"org.ragfoundry": {"dark": "#ffffff"}}},
      "border": {"$value": "#1d6b37", "$extensions": {"org.ragfoundry": {"dark": "#1d6b37"}}}
    },
    "rejected": {
      "$description": "Failed checks or review. Kept for audit.",
      "bg": {"$value": "#fdecea", "$extensions": {"org.ragfoundry": {"dark": "#3a1512"}}},
      "fg": {"$value": "#a3271c", "$extensions": {"org.ragfoundry": {"dark": "#f7a39a"}}},
      "border": {"$value": "#f4b4ad", "$extensions": {"org.ragfoundry": {"dark": "#6e2a23"}}}
    },
    "superseded": {
      "$description": "Replaced by a newer approved version. Strike the label.",
      "bg": {"$value": "#e9ebef", "$extensions": {"org.ragfoundry": {"dark": "#1e232c"}}},
      "fg": {"$value": "#5a6170", "$extensions": {"org.ragfoundry": {"dark": "#858c99"}}},
      "border": {"$value": "#e9ebef", "$extensions": {"org.ragfoundry": {"dark": "#1e232c"}}}
    },
    "success": {
      "$description": "Grounded answers and passed checks.",
      "bg": {"$value": "#e6f4ea", "$extensions": {"org.ragfoundry": {"dark": "#12301d"}}},
      "fg": {"$value": "#17592d", "$extensions": {"org.ragfoundry": {"dark": "#8fdca6"}}},
      "border": {"$value": "#a9d8b8", "$extensions": {"org.ragfoundry": {"dark": "#1f5a33"}}}
    },
    "info": {
      "$description": "Neutral notices, such as access-scoped results.",
      "bg": {"$value": "#eef2fe", "$extensions": {"org.ragfoundry": {"dark": "#101d4f"}}},
      "fg": {"$value": "#1b3288", "$extensions": {"org.ragfoundry": {"dark": "#bccbfa"}}},
      "border": {"$value": "#bccbfa", "$extensions": {"org.ragfoundry": {"dark": "#2340b3"}}}
    },
    "caution": {
      "$description": "Needs attention, not blocking: partly supported answers, schema warnings.",
      "bg": {"$value": "#fef0e7", "$extensions": {"org.ragfoundry": {"dark": "#3a2010"}}},
      "fg": {"$value": "#b54708", "$extensions": {"org.ragfoundry": {"dark": "#f5a872"}}},
      "border": {"$value": "#f9c9a8", "$extensions": {"org.ragfoundry": {"dark": "#6e3b17"}}}
    },
    "danger": {
      "$description": "Blocking errors and destructive actions.",
      "bg": {"$value": "#fdecea", "$extensions": {"org.ragfoundry": {"dark": "#3a1512"}}},
      "fg": {"$value": "#a3271c", "$extensions": {"org.ragfoundry": {"dark": "#f7a39a"}}},
      "border": {"$value": "#f4b4ad", "$extensions": {"org.ragfoundry": {"dark": "#6e2a23"}}}
    }
  },
  "font": {
    "$type": "fontFamily",
    "$description": "Three voices: sans for the system, serif for words quoted from a source, mono for identifiers and numbers.",
    "sans": {"$value": ["IBM Plex Sans", "Helvetica Neue", "sans-serif"]},
    "serif": {"$value": ["Source Serif 4", "Georgia", "serif"]},
    "mono": {"$value": ["IBM Plex Mono", "ui-monospace", "monospace"]}
  },
  "text": {
    "$type": "typography",
    "$description": "Type scale. Sizes in rem from a 16px root.",
    "display": {"$value": {"fontSize": "2.5rem", "lineHeight": "3rem", "fontWeight": 600, "letterSpacing": "-0.02em"}},
    "title-1": {"$value": {"fontSize": "1.75rem", "lineHeight": "2.25rem", "fontWeight": 600, "letterSpacing": "-0.01em"}},
    "title-2": {"$value": {"fontSize": "1.25rem", "lineHeight": "1.75rem", "fontWeight": 600}},
    "title-3": {"$value": {"fontSize": "1rem", "lineHeight": "1.5rem", "fontWeight": 600}},
    "body-lg": {"$description": "Answers and long reading.", "$value": {"fontSize": "1rem", "lineHeight": "1.625rem", "fontWeight": 400}},
    "body": {"$description": "Default interface text.", "$value": {"fontSize": "0.875rem", "lineHeight": "1.375rem", "fontWeight": 400}},
    "small": {"$value": {"fontSize": "0.8125rem", "lineHeight": "1.25rem", "fontWeight": 400}},
    "label": {"$value": {"fontSize": "0.75rem", "lineHeight": "1rem", "fontWeight": 500}},
    "overline": {"$description": "Use with the mono font, uppercase.", "$value": {"fontSize": "0.6875rem", "lineHeight": "1rem", "fontWeight": 500, "letterSpacing": "0.08em"}},
    "quote": {"$description": "Source excerpts. Use with the serif font.", "$value": {"fontSize": "0.9375rem", "lineHeight": "1.5rem", "fontWeight": 400}},
    "code": {"$description": "Identifiers, URIs, scores. Use with the mono font.", "$value": {"fontSize": "0.8125rem", "lineHeight": "1.25rem", "fontWeight": 400}}
  },
  "space": {
    "$type": "dimension",
    "unit": {"$description": "4px grid. Use multiples 0.5, 1, 2, 3, 4, 6, 8, 12 and 16.", "$value": "0.25rem"}
  },
  "size": {
    "$type": "dimension",
    "control-compact": {"$description": "Table rows and dense lists.", "$value": "2rem"},
    "control": {"$description": "Buttons, inputs, list items.", "$value": "2.5rem"},
    "control-touch": {"$description": "Minimum on touch screens.", "$value": "2.75rem"}
  },
  "radius": {
    "$type": "dimension",
    "stamp": {"$description": "Status badges and citation markers.", "$value": "3px"},
    "control": {"$description": "Buttons, inputs, menus.", "$value": "6px"},
    "panel": {"$description": "Cards, panels, dialogs.", "$value": "10px"},
    "pill": {"$description": "Facet chips only.", "$value": "9999px"}
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Borders first. Shadows only for things that float above content.",
    "popover": {"$value": "0 4px 12px rgb(14 17 22 / 0.08)"},
    "dialog": {"$value": "0 16px 40px rgb(14 17 22 / 0.18)"}
  }
}
